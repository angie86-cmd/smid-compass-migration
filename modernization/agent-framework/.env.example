# Copy to .env and fill in locally. Never commit the real .env file.
# Authentication uses Entra ID via DefaultAzureCredential — locally this resolves
# via your existing `az login` session (AzureCliCredential, inside the chain);
# in a deployed Hosted Agent container it resolves via the platform-issued
# managed identity (ManagedIdentityCredential, inside the same chain) instead.
# No API key variable is needed or should be added here.
#
# Only variables actually read by src/smid_compass/config.py are listed here.
# Safe to leave unset: config.py falls back to the live nonprofit DEV endpoint.

FOUNDRY_PROJECT_ENDPOINT=
